{
  "name": "counter-worker-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight counter REST API with a developer website, built on Cloudflare Workers and D1.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create counter-worker-api",
    "db:migrate:local": "wrangler d1 migrations apply counter-worker-api --local",
    "db:migrate:remote": "wrangler d1 migrations apply counter-worker-api --remote",
    "types": "wrangler types",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
